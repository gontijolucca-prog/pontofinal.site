# Cloudflare Pages — cache headers
#
# Cloudflare Pages _headers só faz match no PRIMEIRO segmento com `*`.
# Wildcards no meio do path NÃO funcionam consistentemente. Por isso
# listamos paths explícitos para cada página de aprovação/dashboard.

# Páginas de aprovação Luiz (Maio 2026)
/aprovacao-luiz-202605/*
  Cache-Control: no-store, no-cache, must-revalidate
  Pragma: no-cache
/aprovacao-luiz-202605/js/*
  Cache-Control: no-store, no-cache, must-revalidate
/aprovacao-luiz-202605/js/components/*
  Cache-Control: no-store, no-cache, must-revalidate
/aprovacao-luiz-202605/js/stores/*
  Cache-Control: no-store, no-cache, must-revalidate
/aprovacao-luiz-202605/js/lib/*
  Cache-Control: no-store, no-cache, must-revalidate
/aprovacao-luiz-202605/styles/*
  Cache-Control: no-store, no-cache, must-revalidate
/aprovacao-luiz-202605/data/*
  Cache-Control: no-store, no-cache, must-revalidate
/aprovacao-luiz-202605/sw.js
  Cache-Control: no-store, no-cache, must-revalidate
  Service-Worker-Allowed: /aprovacao-luiz-202605/
/aprovacao-luiz-202605/version.txt
  Cache-Control: no-store, no-cache, must-revalidate

